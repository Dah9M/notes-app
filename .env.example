# --- PostgreSQL (используется контейнером postgres) ---
POSTGRES_DB=notesdb
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://postgres:5432/notesdb
DB_USER=notes
DB_PASSWORD=notes
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:8081

# --- Frontend (подставляется в js/config.js через envsubst) ---
API_BASE_URL=http://localhost:8080
